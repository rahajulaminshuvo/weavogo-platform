    {
      "name": "Login \u2014 Category Manager",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "pm.collectionVariables.set('tokenCat', b.accessToken);",
              "pm.test('token issued', () => pm.expect(b.accessToken).to.be.a('string'));",
              "pm.test('roles present', () => pm.expect(b.roles.length).to.be.above(0));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/login",
          "host": [
            "{{baseUrl}}/api/v1/auth/login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userName\": \"catmgr\",\n  \"password\": \"{{password}}\"\n}"
        }
      }
    },
